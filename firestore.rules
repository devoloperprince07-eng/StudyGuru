rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "devoloperprince07@gmail.com";
    }
    function validClass(value) {
      return value in ['10', '11', '12'];
    }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /users/{uid} {
      // A student can read their own profile; Admin can read all profiles.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'class', 'role', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && validClass(request.resource.data.class)
        && request.resource.data.role == 'student'
        && request.resource.data.createdAt is timestamp;

      // Users may update only their own basic profile fields.
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'class'])
          && request.resource.data.name is string
          && validClass(request.resource.data.class))
        ||
        // Admin can promote/demote users, but cannot grant admin via a profile field.
        (isAdmin()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'roleUpdatedAt', 'roleUpdatedBy'])
          && request.resource.data.role in ['student', 'teacher']
          && request.resource.data.roleUpdatedBy == request.auth.uid)
      );
      allow delete: if isAdmin();

    }

    match /courses/{courseId} {
      allow read: if signedIn() && (
        isAdmin()
        || (resource.data.active == true)
        || resource.data.teacherId == request.auth.uid
      );

      // Teachers may create only their own unpublished course drafts.
      allow create: if signedIn()
        && isTeacher()
        && !isAdmin()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.active == false
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 90
        && request.resource.data.class in ['10', '11', '12']
        && request.resource.data.subject is string
        && request.resource.data.description is string;

      // Admin approves/publishes or edits course records.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /pdfs/{pdfId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title','class','subject','fileName','storagePath','uploadedBy','createdAt'])
        && request.resource.data.title is string
        && request.resource.data.class in ['10','11','12','All']
        && request.resource.data.subject is string
        && request.resource.data.fileName is string
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('pdfs/' + request.auth.uid + '/.*')
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}