rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'devoloperprince07@gmail.com';
    }
    function isTeacher() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function validClass(value) { return value in ['10', '11', '12']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','class','role','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && validClass(request.resource.data.class)
        && request.resource.data.role == 'student';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','class'])
          && request.resource.data.name is string
          && validClass(request.resource.data.class));
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.active == true)
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isAdmin()
        || (isTeacher()
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.keys().hasOnly(['title','class','subject','description','teacherId','active','createdAt'])
          && request.resource.data.title is string
          && validClass(request.resource.data.class)
          && request.resource.data.subject is string
          && request.resource.data.active == false);
      allow update: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','class','subject','description','active'])
          && request.resource.data.active == false);
      allow delete: if isAdmin();
    }

    match /pdfs/{pdfId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title','class','subject','fileName','storagePath','uploadedBy','createdAt'])
        && request.resource.data.title is string
        && request.resource.data.class in ['10','11','12','All']
        && request.resource.data.subject is string
        && request.resource.data.fileName is string
        && request.resource.data.storagePath is string
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
